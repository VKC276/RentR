[Unit]
Description=VKK Rental door relay listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vkc
Group=vkc
WorkingDirectory=/home/vkc/RentR/pi
Environment=ENV_FILE=/etc/vkk-rental-door.env
ExecStart=/home/vkc/RentR/pi/.venv/bin/python /home/vkc/RentR/pi/door_listener.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
