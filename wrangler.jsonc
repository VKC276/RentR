{
  "name": "rentr-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-01",
  "account_id": "3e979ddd9a61da24577bef87510fde29",
  "workers_dev": true,
  // Samma hemlighet som på wallflow: npx wrangler secret put RENTAL_BRIDGE_SECRET
  "vars": {
    "WALLFLOW_API_URL": "https://wallflow.muddy-rice-38d4.workers.dev"
  },
  "services": [
    {
      "binding": "WALLFLOW",
      "service": "wallflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rentr",
      "database_id": "fa835844-34a7-4540-b766-f527622a6bda",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
